{
  // Example config.json for Your Launcher. Copy to %APPDATA%\Your Launcher\config.json
  // (or wherever YOURLAUNCHER_CONFIG_DIR points) and edit to taste. Comments and trailing
  // commas are fine — the parser accepts both.
  "version": 1,
  "settings": {
    "hotkey": "Alt+Space",
    "theme": "system",
    "opacity": 90,
    "useWindowsAccent": false,
    // Where the panel opens: "center" (a third of the way down), "top" or "bottom" (docked to that edge).
    // edgeMargin is the gap in px between the screen edge and a top/bottom-docked panel.
    "position": "center",
    "edgeMargin": 0,
    // "floating" (default) or "docked": an opaque panel fused with the screen edge (opacity is ignored).
    // Applied at the next start.
    "panelStyle": "floating",
    "includeOtherDesktopWindows": false,
    "startWithWindows": true,
    "closeAfterLaunch": true,
    "maxVisibleItems": 8,
    "defaultShell": "pwsh",
    "rememberLastLocation": false,
    "showHintBar": true,
    // Type "<prefix> <text>" (e.g. "f report") to search files with Everything (when it is running) or the
    // Windows Search index. Empty turns file search off.
    "fileSearchPrefix": "f",
  },
  "root": {
    "id": "root",
    "type": "folder",
    "name": "Root",
    "children": [
      {
        "id": "dev",
        "type": "folder",
        "name": "Dev",
        "children": [
          {
            "id": "dev-tools",
            "type": "folder",
            "name": "Tools",
            "children": [
              {
                "id": "vscode",
                "type": "app",
                "name": "VS Code",
                "target": "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe",
                "arguments": "",
                "workingDirectory": null,
                "runAsAdmin": false,
                "keywords": ["editor", "ide"],
                "description": "Code editor",
              },
              {
                "id": "notepad",
                "type": "app",
                "name": "Notepad",
                "target": "C:\\Windows\\notepad.exe",
                "hotkey": "Ctrl+Shift+Alt+N", // starts Notepad from anywhere, without opening the panel (avoid plain Ctrl+Alt+key: that is AltGr)
                "keywords": ["defter", "not"],
              },
            ],
          },
          {
            "id": "dev-scripts",
            "type": "folder",
            "name": "Scripts",
            "children": [
              {
                "id": "build-deploy",
                "type": "command",
                "name": "Build & Deploy",
                "command": "Get-Date; git --version",
                "shell": "pwsh",
                "window": "visible",
                "keepOpen": true,
                "runAsAdmin": false,
                "keywords": ["ci", "release"],
                "description": "Runs the local build and deploy script",
              },
              {
                "id": "write-marker",
                "type": "command",
                "name": "Write Marker File",
                "command": "echo hi > %TEMP%\\yl.txt",
                "shell": "cmd",
                "window": "hidden",
                "keepOpen": false,
              },
              {
                "id": "list-services",
                "type": "command",
                "name": "List Running Services",
                "command": "Get-Service | Where-Object Status -eq Running",
                "shell": "powershell",
                "window": "visible",
                "keepOpen": true,
                "runAsAdmin": false,
              },
            ],
          },
        ],
      },
      {
        "id": "documents",
        "type": "path",
        "name": "Documents",
        "target": "%USERPROFILE%\\Documents",
      },
      {
        "id": "haftalik-rapor",
        "type": "path",
        "name": "Haftalık Rapor",
        "target": "%USERPROFILE%\\Documents\\Haftalik Rapor.xlsx",
        "description": "Weekly report spreadsheet",
      },
      {
        "id": "sifre-yoneticisi",
        "type": "app",
        "name": "Şifre Yöneticisi",
        "target": "%LOCALAPPDATA%\\Programs\\KeePassXC\\KeePassXC.exe",
        "keywords": ["password", "vault"],
        "description": "Password manager",
      },
      {
        "id": "anthropic",
        "type": "url",
        "name": "Anthropic",
        "target": "https://www.anthropic.com",
        "keywords": ["ai", "claude"],
      },
      {
        // Parameterized item: type "gh dotnet runtime" and Enter opens the search results. {query} is
        // replaced (URL-encoded) by the text after the keyword; do not put quotes around it.
        "id": "github-search",
        "type": "url",
        "name": "GitHub Search",
        "target": "https://github.com/search?q={query}",
        "keywords": ["gh"],
      },
    ],
  },
}
