<Window x:Class="YourLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:YourLauncher.App.Converters"
        xmlns:controls="clr-namespace:YourLauncher.App.Controls"
        xmlns:local="clr-namespace:YourLauncher.App.Views"
        Title="Your Launcher"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="640"
        Background="#1E1E1E"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="14"
        Foreground="#E6E6E6"
        Deactivated="MainWindow_OnDeactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringEmptyToVisibilityConverter x:Key="EmptyToVis" />
        <conv:StringNonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:IconTierVisibilityConverter x:Key="IconTierToVis" />
        <conv:MissingTargetTooltipConverter x:Key="MissingTargetTooltip" />
    </Window.Resources>

    <Border BorderBrush="#3B4048" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search box + breadcrumb (hidden on the TypePicker/Editor pages) -->
            <Grid Grid.Row="0" Margin="12,10,12,10" Visibility="{Binding IsListPage, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock Text="Search…"
                               Foreground="#8A8A8A"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E6E6E6"
                             CaretBrush="#E6E6E6"
                             VerticalAlignment="Center"
                             IsReadOnly="{Binding ShowConfirmBar}"
                             PreviewKeyDown="SearchBox_OnPreviewKeyDown" />
                </Grid>

                <TextBlock Grid.Column="1"
                           Text="{Binding Breadcrumb}"
                           Foreground="#8A8A8A"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>

            <!-- Breadcrumb-only header for the TypePicker/Editor pages (search box hidden there) -->
            <Grid Grid.Row="0" Margin="12,10,12,10">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListPage}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock Text="{Binding Breadcrumb}" Foreground="#8A8A8A" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="#3B4048" BorderThickness="0,1,0,0" />

            <!-- Item list (List / ConfirmDelete pages) -->
            <ListBox x:Name="ItemsList"
                     Grid.Row="2"
                     ItemsSource="{Binding Items}"
                     SelectedIndex="{Binding SelectedIndex, Mode=OneWay}"
                     Focusable="False"
                     Foreground="#E6E6E6"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsListPage}" Value="True" />
                                    <Condition Binding="{Binding HasItems}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="Height" Value="{x:Static local:MainWindow.RowHeight}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="3,0,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2D2D30" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding IsTargetMissing, Converter={StaticResource MissingTargetTooltip}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTargetMissing}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCut}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                            <Setter Property="TextElement.FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Icon cell: IconImage -> EmojiText -> Glyph (spec §4.3), plus a bottom-right
                                 warning badge when the app/path target can't be found. -->
                            <Grid Grid.Column="0" Width="24" Height="24">
                                <Image Width="20" Height="20"
                                       Source="{Binding IconImage}"
                                       Visibility="{Binding IconImage, Converter={StaticResource NullToVis}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding EmojiText}"
                                           FontFamily="Segoe UI Emoji"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource IconTierToVis}" ConverterParameter="Emoji">
                                            <Binding Path="IconImage" />
                                            <Binding Path="EmojiText" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource IconTierToVis}" ConverterParameter="Glyph">
                                            <Binding Path="IconImage" />
                                            <Binding Path="EmojiText" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="#E5A050"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Visibility="{Binding IsTargetMissing, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       controls:HighlightedText.Text="{Binding Name}"
                                       controls:HighlightedText.Positions="{Binding HighlightPositions}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,8,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SecondaryText}"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty-folder message -->
            <TextBlock Grid.Row="2"
                       Text="{Binding EmptyMessage}"
                       Foreground="#8A8A8A"
                       Margin="12,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsListPage}" Value="True" />
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Type picker page. Visibility must bind against MainViewModel (the ambient DataContext at
                 this point in the tree), so it's set on this wrapper rather than on TypePickerView itself
                 - that element's own DataContext is reassigned to TypePicker just below, and a binding on
                 the very same element it's reassigned on would resolve against the NEW DataContext, not
                 the old one, silently failing (no ShowTypePickerPage property on TypePickerViewModel) and
                 leaving Visibility at its default (Visible) forever. -->
            <Grid Grid.Row="2" Visibility="{Binding ShowTypePickerPage, Converter={StaticResource BoolToVis}}">
                <local:TypePickerView x:Name="TypePickerViewHost" DataContext="{Binding TypePicker}" />
            </Grid>

            <!-- Editor page - same reasoning as above. -->
            <Grid Grid.Row="2" Visibility="{Binding ShowEditorPage, Converter={StaticResource BoolToVis}}">
                <local:EditorView x:Name="EditorViewHost" DataContext="{Binding Editor}" />
            </Grid>

            <!-- Icon picker page (Ctrl+I) - same reasoning as above. -->
            <Grid Grid.Row="2" Visibility="{Binding ShowIconPickerPage, Converter={StaticResource BoolToVis}}">
                <local:IconPickerView x:Name="IconPickerViewHost" DataContext="{Binding IconPicker}" />
            </Grid>

            <!-- Error line -->
            <TextBlock Grid.Row="3"
                       Text="{Binding ErrorMessage}"
                       Foreground="#E06C75"
                       Margin="12,6"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <!-- Inline delete-confirm bar -->
            <Border Grid.Row="4" BorderBrush="#3B4048" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowConfirmBar, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DeleteConfirmMessage}"
                           Foreground="#E5C07B"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="12,6" />
            </Border>

            <!-- Hint bar -->
            <Border Grid.Row="4" BorderBrush="#3B4048" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowHintBarRow, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding HintText}"
                           Foreground="#8A8A8A"
                           FontSize="12"
                           Margin="12,6" />
            </Border>
        </Grid>
    </Border>
</Window>
