<Window x:Class="YourLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:YourLauncher.App.Converters"
        xmlns:controls="clr-namespace:YourLauncher.App.Controls"
        xmlns:local="clr-namespace:YourLauncher.App.Views"
        Title="Your Launcher"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="640"
        Background="{DynamicResource PanelBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="14"
        Foreground="{DynamicResource ForegroundBrush}"
        Deactivated="MainWindow_OnDeactivated"
        AllowDrop="True"
        DragEnter="Panel_OnDragEnter"
        DragOver="Panel_OnDragOver"
        DragLeave="Panel_OnDragLeave"
        Drop="Panel_OnDrop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringEmptyToVisibilityConverter x:Key="EmptyToVis" />
        <conv:StringNonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:IconTierVisibilityConverter x:Key="IconTierToVis" />
        <conv:MissingTargetTooltipConverter x:Key="MissingTargetTooltip" />
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search box + breadcrumb (hidden on the TypePicker/Editor/IconPicker/Settings pages) -->
            <Grid Grid.Row="0" Margin="12,10,12,10" Visibility="{Binding IsListPage, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock Text="Search…"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             CaretBrush="{DynamicResource ForegroundBrush}"
                             VerticalAlignment="Center"
                             IsReadOnly="{Binding IsConfirmBarActive}"
                             PreviewKeyDown="SearchBox_OnPreviewKeyDown" />
                </Grid>

                <TextBlock Grid.Column="1"
                           Text="{Binding Breadcrumb}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>

            <!-- Breadcrumb-only header for the TypePicker/Editor/IconPicker/Settings pages (search box hidden there) -->
            <Grid Grid.Row="0" Margin="12,10,12,10">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListPage}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock Text="{Binding Breadcrumb}" Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" />

            <!-- Item list (List / ConfirmDelete / ConfirmImport pages) -->
            <ListBox x:Name="ItemsList"
                     Grid.Row="2"
                     ItemsSource="{Binding Items}"
                     SelectedIndex="{Binding SelectedIndex, Mode=OneWay}"
                     Focusable="False"
                     Foreground="{DynamicResource ForegroundBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseRightButtonUp="ItemsList_OnMouseRightButtonUp">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsListPage}" Value="True" />
                                    <Condition Binding="{Binding HasItems}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- Spec §10 item 5 (mouse prerequisite): a ListBoxItem is focusable by default, so
                             clicking a row would steal keyboard focus away from SearchBox - the search
                             TextBox's own PreviewKeyDown handler is what drives every keyboard shortcut, so
                             that must never happen. Selection instead flows through the mouse-down handlers
                             below, which set MainViewModel.SelectedIndex directly (the SelectedIndex binding
                             above is OneWay). -->
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="AllowDrop" Value="True" />
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="Height" Value="{x:Static local:MainWindow.RowHeight}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListItem_OnPreviewMouseLeftButtonDown" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListItem_OnPreviewMouseLeftButtonUp" />
                        <EventSetter Event="PreviewMouseMove" Handler="ListItem_OnPreviewMouseMove" />
                        <EventSetter Event="MouseDoubleClick" Handler="ListItem_OnMouseDoubleClick" />
                        <EventSetter Event="MouseRightButtonUp" Handler="ListItem_OnMouseRightButtonUp" />
                        <EventSetter Event="DragOver" Handler="ListItem_OnDragOver" />
                        <EventSetter Event="DragLeave" Handler="ListItem_OnDragLeave" />
                        <EventSetter Event="Drop" Handler="ListItem_OnDrop" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="3,0,0,0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <!-- In-list drag insertion lines (spec §7/§10 item 8) - a DropIndicator
                                             property on the row's own DataContext, no Adorner. -->
                                        <Border x:Name="DropAboveLine" Height="2" VerticalAlignment="Top"
                                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                        <Border x:Name="DropBelowLine" Height="2" VerticalAlignment="Bottom"
                                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DropIndicator}" Value="Into">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DropIndicator}" Value="Above">
                                            <Setter TargetName="DropAboveLine" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DropIndicator}" Value="Below">
                                            <Setter TargetName="DropBelowLine" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding IsTargetMissing, Converter={StaticResource MissingTargetTooltip}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTargetMissing}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCut}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                            <Setter Property="TextElement.FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Icon cell: IconImage -> EmojiText -> Glyph (spec §4.3), plus a bottom-right
                                 warning badge when the app/path target can't be found. -->
                            <Grid Grid.Column="0" Width="24" Height="24">
                                <Image Width="20" Height="20"
                                       Source="{Binding IconImage}"
                                       Visibility="{Binding IconImage, Converter={StaticResource NullToVis}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding EmojiText}"
                                           FontFamily="Segoe UI Emoji"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource IconTierToVis}" ConverterParameter="Emoji">
                                            <Binding Path="IconImage" />
                                            <Binding Path="EmojiText" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource IconTierToVis}" ConverterParameter="Glyph">
                                            <Binding Path="IconImage" />
                                            <Binding Path="EmojiText" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource MissingBadgeBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Visibility="{Binding IsTargetMissing, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- Name has priority over the secondary text (a search result's folder path
                                 can be long); the path is shortened from its start, full text in its tooltip. -->
                            <controls:NameAndPathPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0">
                                <TextBlock controls:HighlightedText.Text="{Binding Name}"
                                           controls:HighlightedText.Positions="{Binding HighlightPositions}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <controls:PathText Text="{Binding SecondaryText}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                            </controls:NameAndPathPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty-folder message -->
            <TextBlock Grid.Row="2"
                       Text="{Binding EmptyMessage}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="12,10"
                       Background="Transparent"
                       MouseRightButtonUp="ItemsList_OnMouseRightButtonUp">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsListPage}" Value="True" />
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Type picker page. Visibility must bind against MainViewModel (the ambient DataContext at
                 this point in the tree), so it's set on this wrapper rather than on TypePickerView itself
                 - that element's own DataContext is reassigned to TypePicker just below, and a binding on
                 the very same element it's reassigned on would resolve against the NEW DataContext, not
                 the old one, silently failing (no ShowTypePickerPage property on TypePickerViewModel) and
                 leaving Visibility at its default (Visible) forever. -->
            <Grid Grid.Row="2" Visibility="{Binding ShowTypePickerPage, Converter={StaticResource BoolToVis}}">
                <local:TypePickerView x:Name="TypePickerViewHost" DataContext="{Binding TypePicker}" />
            </Grid>

            <!-- Editor page - same reasoning as above. -->
            <Grid Grid.Row="2" Visibility="{Binding ShowEditorPage, Converter={StaticResource BoolToVis}}">
                <local:EditorView x:Name="EditorViewHost" DataContext="{Binding Editor}" />
            </Grid>

            <!-- Icon picker page (Ctrl+I) - same reasoning as above. -->
            <Grid Grid.Row="2" Visibility="{Binding ShowIconPickerPage, Converter={StaticResource BoolToVis}}">
                <local:IconPickerView x:Name="IconPickerViewHost" DataContext="{Binding IconPicker}" />
            </Grid>

            <!-- Settings page (Ctrl+,, Phase 6) - same reasoning as above. -->
            <Grid Grid.Row="2" Visibility="{Binding ShowSettingsPage, Converter={StaticResource BoolToVis}}">
                <local:SettingsView x:Name="SettingsViewHost" DataContext="{Binding Settings}" />
            </Grid>

            <!-- Error line -->
            <TextBlock Grid.Row="3"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ErrorBrush}"
                       Margin="12,6"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <!-- Inline delete-/launch-confirm bar -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowConfirmBar, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ConfirmMessage}"
                           Foreground="{DynamicResource WarningBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="12,6" />
            </Border>

            <!-- Inline import-confirm bar (Ctrl+, > Import…, spec §10 revision item 9) -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowConfirmImportBar, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ImportConfirmMessage}"
                           Foreground="{DynamicResource WarningBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="12,6" />
            </Border>

            <!-- Hint bar -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowHintBarRow, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding HintText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="12,6" />
            </Border>
        </Grid>
    </Border>
</Window>
