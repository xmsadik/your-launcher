<UserControl x:Class="YourLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YourLauncher.App.Converters"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             PreviewKeyDown="SettingsView_OnPreviewKeyDown">
    <UserControl.Resources>
        <conv:StringNonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Width" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="Grid" x:Key="Row">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="12,10,12,10">

        <!-- Hotkey -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Hotkey" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="HotkeyBox"
                     Grid.Column="1"
                     Width="220"
                     HorizontalAlignment="Left"
                     IsReadOnly="True"
                     Cursor="Arrow"
                     Text="{Binding HotkeyText, Mode=OneWay}"
                     GotFocus="HotkeyBox_OnGotFocus"
                     LostFocus="HotkeyBox_OnLostFocus"
                     PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" />
        </Grid>

        <!-- Theme -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Theme" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left" SelectionChanged="ThemeCombo_OnSelectionChanged">
                <ComboBoxItem Content="System" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>
        </Grid>

        <!-- Start with Windows -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Start with Windows" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
        </Grid>

        <!-- Close after launch -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Close after launch" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding CloseAfterLaunch}" VerticalAlignment="Center" />
        </Grid>

        <!-- Visible rows -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Visible rows" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MaxVisibleItemsBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                     Text="{Binding MaxVisibleItems, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Default shell -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Default shell" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ShellCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left" SelectionChanged="ShellCombo_OnSelectionChanged">
                <ComboBoxItem Content="pwsh" />
                <ComboBoxItem Content="powershell" />
                <ComboBoxItem Content="cmd" />
            </ComboBox>
        </Grid>

        <!-- Remember last location -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Remember last location" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding RememberLastLocation}" VerticalAlignment="Center" />
        </Grid>

        <!-- Show hint bar -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Show hint bar" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding ShowHintBar}" VerticalAlignment="Center" />
        </Grid>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Open config folder" Style="{StaticResource ActionButton}" Click="OpenConfigFolderButton_OnClick" />
            <Button Content="Export…" Style="{StaticResource ActionButton}" Click="ExportButton_OnClick" IsEnabled="{Binding CanExportImport}" />
            <Button Content="Import…" Style="{StaticResource ActionButton}" Click="ImportButton_OnClick" IsEnabled="{Binding CanExportImport}" />
            <Button x:Name="ImportBookmarksButton" Content="Import bookmarks…" Style="{StaticResource ActionButton}" Click="ImportBookmarksButton_OnClick" IsEnabled="{Binding CanExportImport}" />
        </StackPanel>

        <!-- Status / error line -->
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource WarningBrush}"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVis}}" />
    </StackPanel>
</UserControl>
