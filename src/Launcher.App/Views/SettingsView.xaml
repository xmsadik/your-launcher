<UserControl x:Class="YourLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YourLauncher.App.Converters"
             xmlns:loc="clr-namespace:YourLauncher.App.Localization"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             PreviewKeyDown="SettingsView_OnPreviewKeyDown">
    <UserControl.Resources>
        <conv:StringNonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Width" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="Grid" x:Key="Row">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="12,10,12,10">

        <!-- Hotkey -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsHotkey}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="HotkeyBox"
                     Grid.Column="1"
                     Width="220"
                     HorizontalAlignment="Left"
                     IsReadOnly="True"
                     Cursor="Arrow"
                     Text="{Binding HotkeyText, Mode=OneWay}"
                     GotFocus="HotkeyBox_OnGotFocus"
                     LostFocus="HotkeyBox_OnLostFocus"
                     PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" />
        </Grid>

        <!-- Theme -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsTheme}" Style="{StaticResource FieldLabel}" />
            <!-- Items come from ThemeCatalog.Choices (SettingsView constructor). -->
            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="ThemeCombo_OnSelectionChanged" />
        </Grid>

        <!-- Language (applied at the next start; the note shows while the choice differs from the running language) -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsLanguage}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_OnSelectionChanged">
                <ComboBoxItem Content="{x:Static loc:Strings.SettingsLanguageSystem}" />
                <ComboBoxItem Content="English" />
                <ComboBoxItem Content="Türkçe" />
            </ComboBox>
        </Grid>
        <TextBlock Text="{Binding LanguageNote}"
                   Foreground="{DynamicResource WarningBrush}"
                   Margin="0,-4,0,6"
                   TextWrapping="Wrap"
                   Visibility="{Binding LanguageNote, Converter={StaticResource NonEmptyToVis}}" />

        <!-- Background opacity -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsOpacity}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="OpacityBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                     Text="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Text="%" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>

        <!-- Windows accent color (previews live like Theme/Opacity) -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsUseWindowsAccent}" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding UseWindowsAccent}" VerticalAlignment="Center" />
        </Grid>

        <!-- Window switcher: also list windows on other virtual desktops / hidden GlazeWM workspaces -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsIncludeOtherDesktopWindows}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
            <CheckBox Grid.Column="1" IsChecked="{Binding IncludeOtherDesktopWindows}" VerticalAlignment="Center" />
        </Grid>

        <!-- Start with Windows -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsStartWithWindows}" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding StartupNote}"
                   Foreground="{DynamicResource WarningBrush}"
                   Margin="0,-4,0,6"
                   TextWrapping="Wrap"
                   Visibility="{Binding StartupNote, Converter={StaticResource NonEmptyToVis}}" />

        <!-- Close after launch -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsCloseAfterLaunch}" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding CloseAfterLaunch}" VerticalAlignment="Center" />
        </Grid>

        <!-- Visible rows -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsVisibleRows}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MaxVisibleItemsBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                     Text="{Binding MaxVisibleItems, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Default shell -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsDefaultShell}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ShellCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left" SelectionChanged="ShellCombo_OnSelectionChanged">
                <ComboBoxItem Content="pwsh" />
                <ComboBoxItem Content="powershell" />
                <ComboBoxItem Content="cmd" />
            </ComboBox>
        </Grid>

        <!-- Remember last location -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsRememberLocation}" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding RememberLastLocation}" VerticalAlignment="Center" />
        </Grid>

        <!-- Show hint bar -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsShowHintBar}" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding ShowHintBar}" VerticalAlignment="Center" />
        </Grid>

        <!-- File search prefix -->
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.SettingsFileSearchPrefix}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="FileSearchPrefixBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                     Text="{Binding FileSearchPrefix, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.SettingsFileSearchPrefixHint}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>

        <!-- Buttons -->
        <WrapPanel Margin="0,6,0,0">
            <Button Content="{x:Static loc:Strings.SettingsOpenConfigFolder}" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="OpenConfigFolderButton_OnClick" />
            <Button Content="{x:Static loc:Strings.SettingsOpenPluginsFolder}" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="OpenPluginsFolderButton_OnClick" />
            <Button Content="{x:Static loc:Strings.SettingsExport}" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="ExportButton_OnClick" IsEnabled="{Binding CanExportImport}" />
            <Button Content="{x:Static loc:Strings.SettingsImport}" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="ImportButton_OnClick" IsEnabled="{Binding CanExportImport}" />
            <Button x:Name="ImportBookmarksButton" Content="{x:Static loc:Strings.SettingsImportBookmarks}" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="ImportBookmarksButton_OnClick" IsEnabled="{Binding CanExportImport}" />
            <Button Content="{x:Static loc:Strings.SettingsImportStartMenu}" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="ImportStartMenuButton_OnClick" IsEnabled="{Binding CanExportImport}" />
        </WrapPanel>

        <!-- Status / error line -->
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource WarningBrush}"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVis}}" />
    </StackPanel>
</UserControl>
