<UserControl x:Class="YourLauncher.App.Views.IconPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YourLauncher.App.Converters"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             PreviewKeyDown="IconPickerView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:IconTierVisibilityConverter x:Key="IconTierToVis" />
        <conv:StringNonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />

        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="CaretBrush" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#3B4048" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#3B4048" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style TargetType="Button" x:Key="TabButton">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#3B4048" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Shared 32x32 grid cell used by both the Glyph and Exe/DLL icon grids (fixed 10-column grid, spec §7.8). -->
        <Style TargetType="ListBoxItem" x:Key="GridCellItem">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D30" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="12,10,12,10">

        <!-- Header: tab strip + "Current:" preview (spec §7.9) -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="GlyphTabButton" Content="Glyph" Click="GlyphTabButton_OnClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Glyph">
                                    <Setter Property="Background" Value="#2D2D30" />
                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="EmojiTabButton" Content="Emoji" Click="EmojiTabButton_OnClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Emoji">
                                    <Setter Property="Background" Value="#2D2D30" />
                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="FileTabButton" Content="File" Click="FileTabButton_OnClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="File">
                                    <Setter Property="Background" Value="#2D2D30" />
                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ExeTabButton" Content="Exe/DLL" Click="ExeTabButton_OnClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Exe">
                                    <Setter Property="Background" Value="#2D2D30" />
                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Current:" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Image Width="18" Height="18" Source="{Binding CurrentImage}"
                       Visibility="{Binding CurrentImage, Converter={StaticResource NullToVis}}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock FontFamily="Segoe UI Emoji" FontSize="15" Text="{Binding CurrentEmoji}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource IconTierToVis}" ConverterParameter="Emoji">
                            <Binding Path="CurrentImage" />
                            <Binding Path="CurrentEmoji" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Text="{Binding CurrentGlyph}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource IconTierToVis}" ConverterParameter="Glyph">
                            <Binding Path="CurrentImage" />
                            <Binding Path="CurrentEmoji" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock Text="{Binding CurrentDescription}" Foreground="#8A8A8A" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Glyph tab -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveTab}" Value="Glyph">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBox x:Name="GlyphFilterBox" Style="{StaticResource FieldBox}"
                     Text="{Binding GlyphFilterText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="GlyphFilterBox_OnPreviewKeyDown" />

            <ListBox x:Name="GlyphList" Margin="0,8,0,0" MaxHeight="200"
                     ItemsSource="{Binding FilteredGlyphs}"
                     SelectedIndex="{Binding GlyphSelectedIndex, Mode=OneWay}"
                     Focusable="False" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="GlyphList_OnSelectionChanged"
                     MouseDoubleClick="GlyphList_OnMouseDoubleClick"
                     ItemContainerStyle="{StaticResource GridCellItem}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="10" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Glyph}" ToolTip="{Binding Name}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#E6E6E6" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Emoji tab -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveTab}" Value="Emoji">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="Type or paste a single emoji, then press Enter." Foreground="#8A8A8A" Margin="0,0,0,8" />
            <TextBox x:Name="EmojiBox" Style="{StaticResource FieldBox}" Width="120" HorizontalAlignment="Left"
                     FontFamily="Segoe UI Emoji" FontSize="18"
                     Text="{Binding EmojiText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="EmojiBox_OnPreviewKeyDown" />
            <TextBlock Text="{Binding EmojiError}" Foreground="#E06C75" FontSize="12" Margin="0,6,0,0"
                       Visibility="{Binding EmojiError, Converter={StaticResource NonEmptyToVis}}" />
        </StackPanel>

        <!-- File tab -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveTab}" Value="File">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Pick a PNG, ICO, JPG, BMP or GIF file. It's copied into the config's icons folder so it survives the source file moving or being deleted." />
            <Button x:Name="BrowseFileButton" Content="Browse…" Style="{StaticResource ActionButton}"
                    Margin="0" HorizontalAlignment="Left" Click="BrowseFileButton_OnClick" />
        </StackPanel>

        <!-- Exe/DLL tab -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveTab}" Value="Exe">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExePathBox" Grid.Column="0" Style="{StaticResource FieldBox}"
                         Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="ExePathBox_OnPreviewKeyDown" />
                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ActionButton}" Click="BrowseExeButton_OnClick" />
                <Button Grid.Column="2" Content="Load" Style="{StaticResource ActionButton}" Click="LoadExeButton_OnClick" />
            </Grid>

            <TextBlock Text="{Binding ExeStatusText}" Foreground="#8A8A8A" FontSize="12" Margin="0,6,0,6" />

            <ListBox x:Name="ExeIconsList" MaxHeight="180"
                     ItemsSource="{Binding ExeIcons}"
                     SelectedIndex="{Binding ExeSelectedIndex, Mode=OneWay}"
                     Focusable="False" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="ExeIconsList_OnSelectionChanged"
                     MouseDoubleClick="ExeIconsList_OnMouseDoubleClick"
                     ItemContainerStyle="{StaticResource GridCellItem}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="10" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Image}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </StackPanel>
</UserControl>
