<UserControl x:Class="YourLauncher.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YourLauncher.App.Converters"
             xmlns:loc="clr-namespace:YourLauncher.App.Localization"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             PreviewKeyDown="EditorView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringNonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
        <conv:StringEmptyToVisibilityConverter x:Key="EmptyToVis" />

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Width" Value="112" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldHint">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <!--
            The Shell/Window ComboBoxes get their dark/light-aware chrome from the implicit ComboBox/
            ComboBoxItem styles in Themes/Dark.xaml + Themes/Light.xaml (spec §10 item 3) - no local Style
            needed here anymore; SettingsView's Theme/Default shell ComboBoxes share the exact same
            template this way instead of duplicating it.
        -->

        <Style TargetType="Button" x:Key="BrowseButton">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="12,10,12,10">

        <!-- Name -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorName}" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Column="1">
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding NameError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12"
                           Margin="0,2,0,0"
                           Visibility="{Binding NameError, Converter={StaticResource NonEmptyToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Target (app / path / url) -->
        <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCommand}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}">
                <TextBlock.Text>
                    <Binding Path="IsUrl">
                        <Binding.Converter>
                            <conv:UrlOrTargetLabelConverter />
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Text>
            </TextBlock>
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TargetBox"
                             Width="360"
                             Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="TargetBox_OnLostFocus" />
                    <Button Content="{x:Static loc:Strings.ButtonBrowse}"
                            Style="{StaticResource BrowseButton}"
                            Click="BrowseFile_OnClick"
                            Visibility="{Binding ShowTargetBrowse, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{x:Static loc:Strings.ButtonBrowseFolder}"
                            Style="{StaticResource BrowseButton}"
                            Click="BrowseFolder_OnClick"
                            Visibility="{Binding IsPath, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding QueryHint}"
                           Style="{StaticResource FieldHint}"
                           Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Command (multi-line) + Shell -->
        <StackPanel Visibility="{Binding IsCommand, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorCommand}" Style="{StaticResource FieldLabel}" />
                <StackPanel Grid.Column="1">
                    <TextBox x:Name="CommandBox"
                             Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{Binding QueryHint}" Style="{StaticResource FieldHint}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorShell}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox x:Name="ShellCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left" SelectionChanged="ShellCombo_OnSelectionChanged">
                    <ComboBoxItem Content="{x:Static loc:Strings.EditorShellDefault}" />
                    <ComboBoxItem Content="pwsh" />
                    <ComboBoxItem Content="powershell" />
                    <ComboBoxItem Content="cmd" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Advanced ▸ -->
        <StackPanel Visibility="{Binding ShowAdvancedSection, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
            <TextBlock x:Name="AdvancedToggle"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Cursor="Hand"
                       MouseLeftButtonUp="AdvancedToggle_OnMouseLeftButtonUp">
                <TextBlock.Text>
                    <Binding Path="IsAdvancedExpanded">
                        <Binding.Converter>
                            <conv:AdvancedToggleTextConverter />
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Text>
            </TextBlock>

            <StackPanel Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">

                <!-- app: Arguments -->
                <Grid Margin="0,4,0,4" Visibility="{Binding IsApp, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorArguments}" Style="{StaticResource FieldLabel}" />
                    <StackPanel Grid.Column="1">
                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding QueryHint}" Style="{StaticResource FieldHint}" />
                    </StackPanel>
                </Grid>

                <!-- app + command: Working directory -->
                <Grid Margin="0,4,0,4" Visibility="{Binding ShowWorkingDirectory, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorWorkingDirectory}" Style="{StaticResource FieldLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="WorkingDirectoryBox" Width="300" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{x:Static loc:Strings.ButtonBrowse}" Style="{StaticResource BrowseButton}" Click="BrowseWorkingDirectory_OnClick" />
                    </StackPanel>
                </Grid>

                <!-- command: Window -->
                <Grid Margin="0,4,0,4" Visibility="{Binding IsCommand, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorWindow}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ComboBox x:Name="WindowCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left" SelectionChanged="WindowCombo_OnSelectionChanged">
                        <ComboBoxItem Content="{x:Static loc:Strings.EditorWindowVisible}" />
                        <ComboBoxItem Content="{x:Static loc:Strings.EditorWindowHidden}" />
                    </ComboBox>
                </Grid>

                <!-- command: Keep open -->
                <CheckBox Content="{x:Static loc:Strings.EditorKeepOpen}"
                          IsChecked="{Binding KeepOpen}"
                          IsEnabled="{Binding KeepOpenEnabled}"
                          Visibility="{Binding IsCommand, Converter={StaticResource BoolToVis}}" />

                <!-- app + command: Run as administrator -->
                <CheckBox Content="{x:Static loc:Strings.EditorRunAsAdmin}"
                          IsChecked="{Binding RunAsAdmin}"
                          Visibility="{Binding ShowRunAsAdmin, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </StackPanel>

        <!-- every type except folder: ask before launching -->
        <CheckBox Content="{x:Static loc:Strings.EditorAskBeforeLaunch}"
                  Margin="0,10,0,0"
                  IsChecked="{Binding ConfirmLaunch}"
                  Visibility="{Binding ShowConfirmLaunch, Converter={StaticResource BoolToVis}}" />

        <!-- Keywords -->
        <Grid Margin="0,10,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorKeywords}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding KeywordsText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Hotkey (every type except folder): captured like the settings page's, Backspace clears -->
        <Grid Margin="0,4,0,4" Visibility="{Binding ShowHotkey, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorHotkeyLabel}" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Column="1">
                <TextBox x:Name="HotkeyBox"
                         Width="220"
                         HorizontalAlignment="Left"
                         IsReadOnly="True"
                         Cursor="Arrow"
                         Text="{Binding HotkeyText, Mode=OneWay}"
                         GotFocus="HotkeyBox_OnGotFocus"
                         LostFocus="HotkeyBox_OnLostFocus"
                         PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" />
                <TextBlock Text="{Binding HotkeyHint}" Style="{StaticResource FieldHint}" />
                <TextBlock Text="{Binding HotkeyError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HotkeyError, Converter={StaticResource NonEmptyToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Description -->
        <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorDescription}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Icon (read-only preview; spec §7.13 - actual change happens via Ctrl+I on the list, not here) -->
        <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditorIcon}" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding IconPreviewEmoji}"
                           FontFamily="Segoe UI Emoji"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Visibility="{Binding IconPreviewEmoji, Converter={StaticResource NonEmptyToVis}}" />
                <TextBlock Text="{Binding IconPreviewGlyph}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Visibility="{Binding IconPreviewEmoji, Converter={StaticResource EmptyToVis}}" />
                <TextBlock Text="{Binding IconDescription}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static loc:Strings.EditorIconChangeHint}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Warning (target not found) -->
        <TextBlock Text="{Binding WarningMessage}"
                   Foreground="{DynamicResource WarningBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding WarningMessage, Converter={StaticResource NonEmptyToVis}}" />
    </StackPanel>
</UserControl>
