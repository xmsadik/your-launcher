<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- windows10.0.19041.0 for the WinRT projection (StartupTask, AppInstance, ApplicationData) the MSIX build
         needs; SupportedOSPlatformVersion keeps the unpackaged exe runnable on Windows 10 2004+. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- UseWindowsForms stays permanently omitted (decision D4, Phase 5 review): the Phase 5 tray icon
         uses a hand-written Shell_NotifyIcon interop (Services/TrayService.cs) instead of WinForms'
         NotifyIcon, specifically so UseWindowsForms never needs to go on alongside UseWPF - that
         combination pulls in ambiguous System.Windows.Forms types (Application, KeyEventArgs, ...) that
         collide with WPF's. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>YourLauncher.App</RootNamespace>
    <AssemblyName>YourLauncher</AssemblyName>
    <!-- Language of the neutral resx (Strings.resx); Strings.tr.resx ships as the tr satellite assembly. -->
    <NeutralLanguage>en</NeutralLanguage>
    <Product>Your Launcher</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Phase 5 §8/§10 item 14: idle memory tuning for the published Release build only - never trades away
       Debug-time diagnostics, and trim is deliberately left OFF (no SetProcessWorkingSetSize hack) so the
       measured numbers in tasks/todo.md reflect the runtime's real footprint. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WinRT projection is ~25 MB of IL of which only StartupTask/AppInstance/ApplicationData are used;
         ReadyToRun-compiling it roughly triples its size for no measurable startup gain. -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

  <!-- Rubik (Dark Glass theme font): static Regular + Medium, SIL OFL 1.1. Embedded as WPF resources (pack://application:,,,/Fonts/);
       the license text ships next to the exe. Static files on purpose - WPF handles variable fonts poorly. -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Content Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

</Project>
