<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- UseWindowsForms stays permanently omitted (decision D4, Phase 5 review): the Phase 5 tray icon
         uses a hand-written Shell_NotifyIcon interop (Services/TrayService.cs) instead of WinForms'
         NotifyIcon, specifically so UseWindowsForms never needs to go on alongside UseWPF - that
         combination pulls in ambiguous System.Windows.Forms types (Application, KeyEventArgs, ...) that
         collide with WPF's. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>YourLauncher.App</RootNamespace>
    <AssemblyName>YourLauncher</AssemblyName>
    <Product>Your Launcher</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Phase 5 §8/§10 item 14: idle memory tuning for the published Release build only - never trades away
       Debug-time diagnostics, and trim is deliberately left OFF (no SetProcessWorkingSetSize hack) so the
       measured numbers in tasks/todo.md reflect the runtime's real footprint. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

</Project>
